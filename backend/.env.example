NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Local web origins allowed by Backend CORS.
CLIENT_WEB_ORIGIN=http://localhost:3000
ADMIN_WEB_ORIGIN=http://localhost:3001
COPYRIGHT_WEB_ORIGIN=http://localhost:3002

# PostgreSQL connection used by the running API.
DATABASE_URL=

# Optional database SSL controls for hosted PostgreSQL.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Migration connection should use a DB role allowed to apply migrations.
DATABASE_MIGRATION_URL=postgresql://poster_migrator:replace_me@127.0.0.1:5432/poster_dev

# Backend-only secrets. Never expose these to Client/Admin/Copyright/Website/Mobile.
SESSION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional override for Razorpay API base URL. Leave blank for the default adapter value.
RAZORPAY_API_BASE_URL=