import React, {
  ReactNode,
  useCallback,
  useState,
} from "react";

import MonetizationFeedbackSheet, {
  MonetizationFeedbackReason,
} from "../dialogs/MonetizationFeedbackSheet";

interface ActiveMonetizationReport {
  itemId: string;

  title: string;

  onSubmit: (
    reason:
      MonetizationFeedbackReason
  ) => void;
}

interface MonetizationFeedbackControllerProps {
  children: (
    openReport: (
      report:
        ActiveMonetizationReport
    ) => void
  ) => ReactNode;
}

export default function MonetizationFeedbackController({
  children,
}: MonetizationFeedbackControllerProps) {
  const [
    activeReport,
    setActiveReport,
  ] =
    useState<
      ActiveMonetizationReport
      | null
    >(null);

  const openReport =
    useCallback(
      (
        report:
          ActiveMonetizationReport
      ) => {
        setActiveReport(report);
      },
      []
    );

  const closeReport =
    useCallback(() => {
      setActiveReport(null);
    }, []);

  const handleSelectReason =
    useCallback(
      (
        reason:
          MonetizationFeedbackReason
      ) => {
        const currentReport =
          activeReport;

        setActiveReport(null);

        currentReport?.onSubmit(
          reason
        );
      },
      [activeReport]
    );

  return (
    <>
      {children(openReport)}

      <MonetizationFeedbackSheet
        visible={
          activeReport !== null
        }
        title={
          activeReport?.title ??
          "Tell us about this promotion"
        }
        onClose={closeReport}
        onSelectReason={
          handleSelectReason
        }
      />
    </>
  );
}