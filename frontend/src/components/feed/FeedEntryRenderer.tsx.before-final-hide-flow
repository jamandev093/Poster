import React, {
  useCallback,
} from "react";
import {
  Linking,
} from "react-native";

import {
  DirectSponsoredCard,
  GoogleNativeAdCard,
  PosterPromotionCard,
} from "../ads";

import FeedCard from "../cards/FeedCard";

import {
  FeedbackReason,
} from "../cards/feedback/feedbackReasons";

import useFeedback from "../../context/FeedbackContext";

import MonetizationAnalyticsService from "../../services/MonetizationAnalyticsService";

import {
  Article,
} from "../../types/article";

import {
  FeedEntry,
} from "../../types/feedEntry";

interface FeedEntryRendererProps {
  entry: FeedEntry;

  onArticlePress: (
    article: Article
  ) => void;

  onArticleBookmark: (
    article: Article
  ) => void;

  onArticleShare: (
    article: Article
  ) => void;

  onArticleWorthReading: (
    article: Article
  ) => void;

  onArticleHelpful: (
    article: Article
  ) => void;

  onArticleFeedback: (
    article: Article,
    reason: FeedbackReason
  ) => void;

  onPromotionPress?: (
    promotionId: string
  ) => void;

  onPromotionReport?: (
    promotionId: string
  ) => void;

  onSponsoredPress?: (
    campaignId: string
  ) => void;

  onSponsoredReport?: (
    campaignId: string
  ) => void;
}

function isSupportedWebUrl(
  value: string
): boolean {
  try {
    const url =
      new URL(value.trim());

    return (
      url.protocol ===
        "https:" ||
      url.protocol ===
        "http:"
    );
  } catch {
    return false;
  }
}

export default function FeedEntryRenderer({
  entry,
  onArticlePress,
  onArticleBookmark,
  onArticleShare,
  onArticleWorthReading,
  onArticleHelpful,
  onArticleFeedback,
  onPromotionPress,
  onPromotionReport,
  onSponsoredPress,
  onSponsoredReport,
}: FeedEntryRendererProps) {
  const { showError } =
    useFeedback();

  const openExternalUrl =
    useCallback(
      async (
        destinationUrl: string
      ) => {
        const normalizedUrl =
          destinationUrl.trim();

        if (
          !isSupportedWebUrl(
            normalizedUrl
          )
        ) {
          showError(
            "Link unavailable",
            "This destination link is invalid or unavailable."
          );

          return;
        }

        try {
          const supported =
            await Linking.canOpenURL(
              normalizedUrl
            );

          if (!supported) {
            showError(
              "Link unavailable",
              "This destination cannot be opened on your device."
            );

            return;
          }

          await Linking.openURL(
            normalizedUrl
          );
        } catch {
          showError(
            "Unable to open link",
            "Poster could not open this external destination."
          );
        }
      },
      [showError]
    );

  switch (entry.type) {
    case "article":
      return (
        <FeedCard
          article={entry.article}
          onPress={() => {
            onArticlePress(
              entry.article
            );
          }}
          onBookmark={() => {
            onArticleBookmark(
              entry.article
            );
          }}
          onShare={() => {
            onArticleShare(
              entry.article
            );
          }}
          onWorthReading={() => {
            onArticleWorthReading(
              entry.article
            );
          }}
          onHelpful={() => {
            onArticleHelpful(
              entry.article
            );
          }}
          onFeedback={(
            reason: FeedbackReason
          ) => {
            onArticleFeedback(
              entry.article,
              reason
            );
          }}
        />
      );

    case "poster_promotion": {
      const handlePress =
        async (
          destinationUrl: string
        ) => {
          try {
            await MonetizationAnalyticsService.recordClick(
              {
                itemId:
                  entry.promotion.id,

                monetizationType:
                  entry.promotion.type,

                placement:
                  entry.promotion
                    .placement,
              }
            );
          } catch {
            // Analytics failure must
            // never block navigation.
          }

          onPromotionPress?.(
            entry.promotion.id
          );

          await openExternalUrl(
            destinationUrl
          );
        };

      const handleReport =
        () => {
          onPromotionReport?.(
            entry.promotion.id
          );
        };

      return (
        <PosterPromotionCard
          promotion={
            entry.promotion
          }
          onPress={(
            destinationUrl
          ) => {
            void handlePress(
              destinationUrl
            );
          }}
          onReport={
            handleReport
          }
        />
      );
    }

    case "poster_affiliate": {
      const handlePress =
        async (
          destinationUrl: string
        ) => {
          try {
            await MonetizationAnalyticsService.recordClick(
              {
                itemId:
                  entry.promotion.id,

                monetizationType:
                  entry.promotion.type,

                placement:
                  entry.promotion
                    .placement,

                advertiserName:
                  entry.promotion
                    .partnerName,
              }
            );
          } catch {
            // Analytics failure must
            // never block navigation.
          }

          onPromotionPress?.(
            entry.promotion.id
          );

          await openExternalUrl(
            destinationUrl
          );
        };

      const handleReport =
        () => {
          onPromotionReport?.(
            entry.promotion.id
          );
        };

      return (
        <PosterPromotionCard
          promotion={
            entry.promotion
          }
          onPress={(
            destinationUrl
          ) => {
            void handlePress(
              destinationUrl
            );
          }}
          onReport={
            handleReport
          }
        />
      );
    }

    case "direct_sponsorship": {
      const handlePress =
        async (
          destinationUrl: string
        ) => {
          try {
            await MonetizationAnalyticsService.recordClick(
              {
                itemId:
                  entry.campaign.id,

                monetizationType:
                  entry.campaign.type,

                placement:
                  entry.campaign
                    .placement,

                campaignId:
                  entry.campaign
                    .campaignId,

                advertiserName:
                  entry.campaign
                    .advertiserName,
              }
            );
          } catch {
            // Analytics failure must
            // never block navigation.
          }

          onSponsoredPress?.(
            entry.campaign
              .campaignId
          );

          await openExternalUrl(
            destinationUrl
          );
        };

      const handleReport =
        () => {
          onSponsoredReport?.(
            entry.campaign
              .campaignId
          );
        };

      return (
        <DirectSponsoredCard
          campaign={
            entry.campaign
          }
          onPress={(
            destinationUrl
          ) => {
            void handlePress(
              destinationUrl
            );
          }}
          onReport={
            handleReport
          }
        />
      );
    }

    case "google_native_ad":
      return (
        <GoogleNativeAdCard
          ad={entry.ad}
        />
      );

    default: {
      const exhaustiveEntry:
        never = entry;

      return exhaustiveEntry;
    }
  }
}