$email = "jaman091190@gmail.com"
$fullName = "Poster Administrator(Jaman)"
$securePassword = Read-Host "P0_$!9?93%#_1A" -AsSecureString
$passwordPointer = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($securePassword)

try {
  $password = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($passwordPointer)

  $signupBody = @{
    email = $email
    password = $password
    fullName = $fullName
  } | ConvertTo-Json

  Invoke-RestMethod `
    -Uri "http://localhost:4000/api/v1/auth/signup" `
    -Method Post `
    -ContentType "application/json" `
    -Body $signupBody
}
finally {
  if ($passwordPointer -ne [IntPtr]::Zero) {
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($passwordPointer)
  }

  Remove-Variable password -ErrorAction SilentlyContinue
  Remove-Variable signupBody -ErrorAction SilentlyContinue
}





