NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Local web origins allowed by Backend CORS.
CLIENT_WEB_ORIGIN=http://localhost:3000
ADMIN_WEB_ORIGIN=http://localhost:3001
COPYRIGHT_WEB_ORIGIN=http://localhost:3002

# PostgreSQL connection used by the running API.
DATABASE_URL=

# Optional database SSL controls for hosted PostgreSQL.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Migration connection should use a DB role allowed to apply migrations.
DATABASE_MIGRATION_URL=postgresql://poster_migrator:replace_me@127.0.0.1:5432/poster_dev

# Backend-only secrets. Never expose these to Client/Admin/Copyright/Website/Mobile.
SESSION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional override for Razorpay API base URL. Leave blank for the default adapter value.
RAZORPAY_API_BASE_URL=

# Poster Brain Python AI classification service.
# Leave POSTER_AI_CLASSIFICATION_URL empty to use the built-in rule fallback only.
POSTER_AI_CLASSIFICATION_URL=http://127.0.0.1:8080/v1/classify
POSTER_AI_CLASSIFICATION_TIMEOUT_MS=3000
POSTER_AI_API_KEY=
POSTER_AI_DEFAULT_MODEL=

# Poster Brain frozen learning dataset handoff to Python AI.
POSTER_AI_TRAINING_HANDOFF_URL=http://127.0.0.1:8080/v1/training-dataset/handoff
POSTER_AI_TRAINING_HANDOFF_TIMEOUT_MS=120000
POSTER_AI_TRAINING_HANDOFF_PAGE_SIZE=5000
POSTER_AI_TRAINING_URL=http://127.0.0.1:8080/v1/training-dataset/train
POSTER_AI_TRAINING_TIMEOUT_MS=120000
POSTER_AI_TRAINING_PAGE_SIZE=5000
POSTER_AI_EMBEDDING_URL=http://127.0.0.1:8080/v1/embed
POSTER_AI_EMBEDDING_TIMEOUT_MS=30000
YOUTUBE_API_KEY=
