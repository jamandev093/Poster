# Mobile public API base convention for future Backend-connected flows.
# Current Mobile app may not consume this variable yet.
EXPO_PUBLIC_POSTER_API_BASE_URL=http://localhost:4000

# Google Mobile Ads Native placement IDs.
# Development Native requests use Google's TestIds.NATIVE automatically.
# Production builds require the real placement-specific AdMob unit IDs.
EXPO_PUBLIC_GOOGLE_NATIVE_AD_UNIT_HOME=
EXPO_PUBLIC_GOOGLE_NATIVE_AD_UNIT_SEARCH=
EXPO_PUBLIC_GOOGLE_NATIVE_AD_UNIT_TRENDING=

# Public Google OAuth Web/Server client ID.
# This value is not a secret. It must match Backend GOOGLE_OAUTH_WEB_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=

# Build-time reversed iOS Google OAuth client URL scheme.
# Example: com.googleusercontent.apps.<ios-client-id>
GOOGLE_IOS_URL_SCHEME=
