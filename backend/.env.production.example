NODE_ENV=production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Production web origins allowed by Backend CORS.
CLIENT_WEB_ORIGIN=https://client.getpostar.com
ADMIN_WEB_ORIGIN=https://admin.getpostar.com
COPYRIGHT_WEB_ORIGIN=https://copyright.getpostar.com

# PostgreSQL connection used by the running API.
DATABASE_URL=

# Hosted PostgreSQL should use SSL unless the provider explicitly says otherwise.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Migration connection should be separate from the runtime application connection.
DATABASE_MIGRATION_URL=

# Backend-only secrets. Never expose these to Client/Admin/Copyright/Website/Mobile.
SESSION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional override for Razorpay API base URL. Leave blank for the default adapter value.
RAZORPAY_API_BASE_URL=

# Poster Brain Python AI classification service.
# Leave POSTER_AI_CLASSIFICATION_URL empty to use the built-in rule fallback only.
POSTER_AI_CLASSIFICATION_URL=
POSTER_AI_CLASSIFICATION_TIMEOUT_MS=3000
POSTER_AI_API_KEY=
POSTER_AI_DEFAULT_MODEL=

# Poster Brain frozen learning dataset handoff to Python AI.
POSTER_AI_TRAINING_HANDOFF_URL=
POSTER_AI_TRAINING_HANDOFF_TIMEOUT_MS=120000
POSTER_AI_TRAINING_HANDOFF_PAGE_SIZE=5000
POSTER_AI_TRAINING_URL=
POSTER_AI_TRAINING_TIMEOUT_MS=120000
POSTER_AI_TRAINING_PAGE_SIZE=5000
POSTER_AI_EMBEDDING_URL=
POSTER_AI_EMBEDDING_TIMEOUT_MS=30000
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
META_GRAPH_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
GUARDIAN_API_KEY=
NCBI_EUTILS_EMAIL=
NCBI_EUTILS_API_KEY=
SMITHSONIAN_API_KEY=
OPENALEX_API_KEY=
NEWSAPI_API_KEY=
NEWSCATCHER_API_KEY=
EVENT_REGISTRY_API_KEY=
