# Website server-side public API base URL.
POSTER_PUBLIC_API_BASE_URL=https://api.getpostar.com

# Public fallback used only if a future client component needs the same public API base.
NEXT_PUBLIC_POSTER_API_BASE_URL=https://api.getpostar.com

# Legacy fallback only. Prefer POSTER_PUBLIC_API_BASE_URL or NEXT_PUBLIC_POSTER_API_BASE_URL.
