# Mobile public API base convention for future Backend-connected flows.
# Current Mobile app may not consume this variable yet.
EXPO_PUBLIC_POSTER_API_BASE_URL=https://api.getpostar.com

# Google Mobile Ads Native production placement IDs.
# Use the real AdMob Native ad-unit ID assigned to each Poster feed surface.
# Keep Google delivery disabled until consent and device validation are complete.
EXPO_PUBLIC_GOOGLE_NATIVE_AD_UNIT_HOME=
EXPO_PUBLIC_GOOGLE_NATIVE_AD_UNIT_SEARCH=
EXPO_PUBLIC_GOOGLE_NATIVE_AD_UNIT_TRENDING=
