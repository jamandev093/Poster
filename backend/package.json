{
    "name": "poster-backend",
    "version": "0.1.0",
    "private": true,
    "description": "Authoritative Poster API and business-service backend.",
    "type": "module",
    "main": "dist/server.js",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:check": "tsx src/database/database-check.ts",
        "db:migrate": "tsx src/database/migrate.ts",
        "db:migrate:status": "tsx src/database/migrate.ts --status"
    },
    "dependencies": {
        "@fastify/cookie": "11.1.2",
        "@fastify/cors": "11.3.0",
        "@fastify/helmet": "13.1.0",
        "argon2": "0.45.1",
        "dotenv": "17.4.2",
        "fastify": "5.10.0",
        "pg": "8.22.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.1.1",
        "@types/pg": "8.20.0",
        "eslint": "10.8.0",
        "tsx": "4.23.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "vitest": "4.1.10"
    }
}
